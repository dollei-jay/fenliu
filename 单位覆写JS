function main(config) {
  // 插入你的自定义规则到 rules 数组顶部
  const customRules = [
    'DOMAIN-SUFFIX,dollei.top,🌍 国外', // 替换为你需要的节点或策略组名称
    // 'DOMAIN-KEYWORD,internal-oa,DIRECT',
  ];

  if (Array.isArray(config.rules)) {
    config.rules = [...customRules, ...config.rules];
  } else {
    config.rules = customRules;
  }

  return config;
}
